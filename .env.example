# Database Mode: "remote" (Turso/LibSQL) or "local" (SQLite file)
#
# For the Docker deployment (see README "Deploying with Docker"), use:
#   DATABASE_MODE=local
#   TURSO_DATABASE_URL=file:/app/data/learnmap.sqlite
DATABASE_MODE=remote

# Database (Turso/LibSQL) - used when DATABASE_MODE=remote
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Local development (`vp dev`): the Workers runtime cannot open `file:` URLs,
# so run a local LibSQL server instead:
#   docker compose -f docker-compose.dev.yml up -d
#   DATABASE_MODE=remote
#   TURSO_DATABASE_URL=http://127.0.0.1:8080   (no auth token needed)
# TURSO_DATABASE_URL=http://127.0.0.1:8080

# Local SQLite - used when DATABASE_MODE=local
# TURSO_DATABASE_URL=file:../data/learnmap.sqlite

# Sentry (Error Tracking) - optional for local development
VITE_SENTRY_DSN=https://your-sentry-dsn

# Application
SITE_URL=https://your-domain.com

# Authentication (Better Auth)
BETTER_AUTH_URL=https://your-domain.com
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long

# Build-time only (not needed in production runtime)
# SENTRY_AUTH_TOKEN=your-sentry-build-token

# Cloudflare deployment (wrangler) - to be filled later
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_USER=
