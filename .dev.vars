# Local dev overrides for wrangler.json `vars`.
#
# The Cloudflare Vite plugin feeds these to the SSR worker during `pnpm run dev`,
# and `.dev.vars` takes precedence over `vars` in wrangler.json. Without this file
# the dev server would silently connect to the placeholder Turso cloud database
# from wrangler.json instead of the local DB shim on 127.0.0.1:8080, which makes
# seeded data (and deletes) appear to "not work".
#
# Mirror the values in .env so migrations, seeds, and the dev server all share
# the same local database on Windows and Linux.
DATABASE_MODE=remote
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=local
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=learnmap-dev-secret-key-32-chars-minimum!!
SITE_URL=http://localhost:5173
